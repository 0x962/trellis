+from __future__ import annotations
+
+import json
+from typing import TYPE_CHECKING, TypedDict
+from uuid import UUID
+
+if TYPE_CHECKING:
+    from lfx.graph.graph.base import Graph
+
+    from langflow.services.jobs.service import JobService
+
+
+class ContinuationConsumptionReceipt(TypedDict):
+    version: int
+    engineJobId: str
+    engineRequestId: str
+    decisionId: str | None
+    signalId: str
+    enqueueObligationId: str
+    queuedAt: str
+    queueClaimed: bool
+
+
+class TrellisExternalWaitBroker:
+    """Keep exact completion bytes while Langflow retains graph ownership."""
+
+    def __init__(self, jobs: JobService) -> None:
+        self._jobs = jobs
+
+    @staticmethod
+    def completion_kind(wait_id: str) -> str:
+        return f"trellis-completion-v1:{wait_id}"
+
+    async def receipt_for(self, graph: Graph, wait_bytes: str) -> str | None:
+        wait_id = json.loads(wait_bytes)["waitId"]
+        envelope_bytes = await self._jobs.load_checkpoint(UUID(graph.job_id), self.completion_kind(wait_id))
+        if envelope_bytes is None:
+            return None
+        envelope = json.loads(envelope_bytes)
+        if envelope["waitBytes"] != wait_bytes:
+            raise RuntimeError("external_wait_identity_conflict")
+        return envelope["receiptBytes"]
+
+    async def save_completion(
+        self,
+        *,
+        job_id: UUID,
+        authority_epoch: int,
+        wait_bytes: str,
+        delivery_bytes: str,
+        receipt_bytes: str,
+    ) -> str:
+        wait = json.loads(wait_bytes)
+        delivery = json.loads(delivery_bytes)
+        receipt = json.loads(receipt_bytes)
+        wait_id = wait["waitId"]
+        if receipt["engineWaitId"] != wait_id:
+            raise RuntimeError("completion_wait_conflict")
+        if wait["kind"] == "native":
+            request = wait["request"]
+            result = delivery["result"]
+            authority = delivery["authority"]
+            if (
+                result["launchBinding"]["executionId"] != request["executionId"]
+                or result["launchBinding"]["publicationId"] != request["publicationId"]
+                or result["launchBinding"]["engineJobId"] != request["engineJobId"]
+                or result["launchBinding"]["engineEpoch"] != request["engineEpoch"]
+                or result["stepId"] != wait["handle"]["stepId"]
+                or result["agentRunId"] != wait["handle"]["agentRunId"]
+                or result["attemptId"] != wait["handle"]["attemptId"]
+                or authority["executionId"] != request["executionId"]
+                or authority["publicationId"] != request["publicationId"]
+                or authority["engineJobId"] != request["engineJobId"]
+                or authority["engineEpoch"] != authority_epoch
+                or "completion.deliver" not in authority["permissions"]
+                or receipt["executionId"] != request["executionId"]
+                or receipt["engineJobId"] != request["engineJobId"]
+                or receipt["completionId"] != result["completionId"]
+                or receipt["resultDigest"] != delivery["resultDigest"]
+            ):
+                raise RuntimeError("completion_binding_conflict")
+        envelope_bytes = json.dumps(
+            {
+                "waitBytes": wait_bytes,
+                "deliveryBytes": delivery_bytes,
+                "receiptBytes": receipt_bytes,
+            },
+            separators=(",", ":"),
+        )
+        saved = await self._jobs.save_checkpoint_once(
+            job_id,
+            self.completion_kind(wait_id),
+            envelope_bytes,
+        )
+        return json.loads(saved)["receiptBytes"]
