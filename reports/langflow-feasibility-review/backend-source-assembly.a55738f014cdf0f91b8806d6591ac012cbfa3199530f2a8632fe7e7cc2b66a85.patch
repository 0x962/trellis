+        enqueue_obligation_id: UUID,
+        continuation_receipt_bytes: bytes,
+    ) -> None:
+        retry_key = f"obligation:{enqueue_obligation_id}"
+
+        async def retry() -> None:
+            await self._enqueue_queued_continuation(
+                engine_job_id=engine_job_id,
+                enqueue_obligation_id=enqueue_obligation_id,
+                continuation_receipt_bytes=continuation_receipt_bytes,
+            )
+            await self._drain_trellis_enqueue_obligations()
+
+        self._schedule_trellis_lease_retry(retry_key, retry)
+
+    def _schedule_trellis_lease_retry(self, retry_key: str, retry: Callable[[], Awaitable[None]]) -> None:
