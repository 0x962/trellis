+    async def await_external_completion(self, wait_bytes: str) -> str:
+        """Save one exact wait and release the worker until its completion arrives."""
+        from lfx.graph.external_wait import ExternalWaitPending
+
+        wait_id = json.loads(wait_bytes)["waitId"]
+        async with self._external_wait_lock:
+            saved = self.external_waits.get(wait_id)
+            if saved is not None and saved != wait_bytes:
+                raise RuntimeError("external_wait_identity_conflict")
+            if self.external_wait_handler is None or self.checkpoint_store is None:
+                raise RuntimeError("external_wait_handler_unavailable")
+            receipt = await self.external_wait_handler(self, wait_bytes)
+            if receipt is not None:
+                self.external_waits.pop(wait_id, None)
+                await self.checkpoint_store.save(self.build_checkpoint())
+                return receipt
+            self.external_waits[wait_id] = wait_bytes
+            await self.checkpoint_store.save(self.build_checkpoint())
+            raise ExternalWaitPending(dict(self.external_waits))
+
+    async def complete_external_wait(self, wait_bytes: str, receipt_bytes: str) -> str:
+        """Remove one exact saved wait after its durable result becomes available."""
