+    async def _continuation_execution_proof(
+        self,
+        job: Job,
+        continuation_receipt_bytes: bytes,
+    ) -> Literal["execution_proven", "cancelled"] | None:
+        """Bind execution proof to the saved continuation receipt and exact signal."""
+        receipt = json.loads(continuation_receipt_bytes)
+        signal_id = receipt["signalId"]
+        if (job.job_metadata or {}).get("continuation_signal_id") != signal_id:
+            return None
+        signals = await get_job_service().unconsumed_signals(job.job_id)
+        signal_is_pending = any(str(signal.id) == signal_id for signal in signals)
+        if job.status == JobStatus.CANCELLED and signal_is_pending:
+            return "cancelled"
+        if job.status == JobStatus.IN_PROGRESS:
+            return "execution_proven"
+        if not signal_is_pending and job.status != JobStatus.QUEUED:
+            return "execution_proven"
+        if job.status != JobStatus.SUSPENDED:
+            return None
+        checkpoint_bytes = await get_job_service().load_checkpoint(job.job_id, "graph")
+        if checkpoint_bytes is None:
+            return None
+        waits = json.loads(checkpoint_bytes).get("external_waits", {})
+        engine_request_id = receipt["engineRequestId"]
+        still_waiting = engine_request_id in waits or any(
+            json.loads(wait_bytes).get("request", {}).get("engineRequestId") == engine_request_id
+            for wait_bytes in waits.values()
+        )
+        return None if still_waiting else "execution_proven"
+
+    def _schedule_trellis_obligation_retry(
