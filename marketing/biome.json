{
	"extends": "//",
	"files": {
		"includes": ["**", "!vendor"]
	},
	"overrides": [
		{
			"includes": ["index.html"],
			"linter": {
				"rules": {
					"a11y": {
						"noNoninteractiveTabindex": "off",
						"useSemanticElements": "off"
					}
				}
			}
		}
	],
	"html": {
		"formatter": {
			"enabled": true
		}
	}
}
