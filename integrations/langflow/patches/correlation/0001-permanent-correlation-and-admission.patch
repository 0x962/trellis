+    async def lookup_trellis_correlation(
+        self, key: CorrelationKey
+    ) -> StoredCorrelation | None:
+        """Read one permanent Trellis correlation and its current job state."""
+        async with session_scope() as session:
+            return await self._trellis_correlation_in_session(session, key)
+
+    async def reserve_trellis_correlation(
+        self,
+        candidate: StoredCorrelation,
+        *,
+        flow_id: UUID,
+        user_id: UUID,
+    ) -> StoredCorrelation:
+        """Commit a queued job and its permanent Trellis correlation together."""
+        from langflow.services.trellis_v1.correlation import (
+            ProtocolConflict,
+            TrellisJobCorrelation,
+        )
+
+        if isinstance(flow_id, str):
+            flow_id = UUID(flow_id)
+        try:
+            async with session_scope() as session:
+                winner = await self._trellis_correlation_in_session(
+                    session, candidate.key
+                )
+                if winner is not None:
+                    return winner
+                metadata = inject_trace_carrier(
+                    {
+                        "trellis_v1": {
+                            "actor_kind": candidate.key.actor_kind,
+                            "actor_name": candidate.key.actor_name,
+                            "request_id": str(candidate.key.request_id),
+                        }
+                    }
+                )
+                job = Job(
+                    job_id=candidate.job_id,
+                    flow_id=flow_id,
+                    status=JobStatus.QUEUED,
+                    type=JobType.WORKFLOW,
+                    user_id=user_id,
+                    dedupe_key=(
+                        f"trellis-v1:{candidate.host_id}:"
+                        f"{candidate.execution_id}"
+                    ),
+                    job_metadata=metadata,
+                )
+                correlation = TrellisJobCorrelation(
+                    actor_kind=candidate.key.actor_kind,
+                    actor_name=candidate.key.actor_name,
+                    request_id=candidate.key.request_id,
+                    host_id=candidate.host_id,
+                    execution_id=candidate.execution_id,
+                    engine_job_id=candidate.job_id,
+                    engine_session_id=candidate.engine_session_id,
+                    barrier_id=candidate.barrier_id,
+                    submission_bytes=candidate.submission_bytes,
+                    submission_bytes_digest=candidate.submission_bytes_digest,
+                    correlation_receipt_bytes=candidate.correlation_receipt_bytes,
+                )
+                session.add(job)
+                session.add(correlation)
+                await session.flush()
+                return candidate
+        except IntegrityError:
+            winner = await self.lookup_trellis_correlation(candidate.key)
+            if winner is not None:
+                return winner
+            async with session_scope() as session:
+                conflict_statement = select(TrellisJobCorrelation).where(
+                    (
+                        (
+                            TrellisJobCorrelation.host_id == candidate.host_id
+                        )
+                        & (
+                            TrellisJobCorrelation.execution_id
+                            == candidate.execution_id
+                        )
+                    )
+                    | (
+                        TrellisJobCorrelation.engine_session_id
+                        == candidate.engine_session_id
+                    )
+                )
+                conflict = (await session.exec(conflict_statement)).first()
+                if conflict is not None:
+                    raise ProtocolConflict(
+                        "engine_correlation_identity_conflict"
+                    )
+            raise
+
+    async def commit_trellis_admission(
+        self,
+        candidate: StoredCorrelation,
+        admission_bytes: bytes,
+        continuation: AdmissionContinuation,
+    ) -> AdmissionCommit:
+        """Commit admission and claim its exact suspended continuation."""
+        from langflow.services.trellis_v1.correlation import (
+            AdmissionCommit,
+            CorrelationUnknown,
+            ProtocolConflict,
+            TrellisJobCorrelation,
+        )
+
+        async with session_scope() as session:
+            statement = (
+                select(TrellisJobCorrelation)
+                .where(
+                    TrellisJobCorrelation.actor_kind == candidate.key.actor_kind,
+                    TrellisJobCorrelation.actor_name == candidate.key.actor_name,
+                    TrellisJobCorrelation.request_id == candidate.key.request_id,
+                )
+                .with_for_update()
+            )
+            correlation = (await session.exec(statement)).first()
+            if correlation is None:
+                raise CorrelationUnknown(candidate.key)
+            job = await session.get(
+                Job,
+                correlation.engine_job_id,
+                with_for_update=True,
+            )
+            if correlation.admission_receipt_bytes is None:
+                if job.status != JobStatus.SUSPENDED:
+                    raise ProtocolConflict("admission_job_not_suspended")
+                correlation.admission_receipt_bytes = admission_bytes
+                correlation.continuation_engine_request_id = (
+                    continuation.engine_request_id
+                )
+                correlation.continuation_signal_id = continuation.signal_id
+                correlation.enqueue_obligation_id = (
+                    continuation.enqueue_obligation_id
+                )
+            elif (
+                correlation.admission_receipt_bytes != admission_bytes
+                or correlation.continuation_engine_request_id
+                != continuation.engine_request_id
+                or correlation.continuation_signal_id != continuation.signal_id
+                or correlation.enqueue_obligation_id
+                != continuation.enqueue_obligation_id
+            ):
+                raise ProtocolConflict("admission_continuation_identity_conflict")
+            signal_data = {
+                "kind": "trellis_external_completion_v1",
+                "engineRequestId": continuation.engine_request_id,
+                "decisionId": None,
+                "enqueueObligationId": str(continuation.enqueue_obligation_id),
+            }
+            signal = await session.get(ExecutionSignal, continuation.signal_id)
+            if signal is None:
+                signal = ExecutionSignal(
+                    id=continuation.signal_id,
+                    job_id=correlation.engine_job_id,
+                    signal_type=SignalType.RESUME,
+                    data=signal_data,
+                )
+                session.add(signal)
+            elif (
+                signal.job_id != correlation.engine_job_id
+                or signal.signal_type != SignalType.RESUME
+                or signal.data != signal_data
+            ):
+                raise ProtocolConflict("admission_signal_identity_conflict")
+            session.add(correlation)
+            await session.flush()
+            continuation_receipt = (
+                await self.consume_suspended_continuation_in_session(
+                    session,
+                    engine_job_id=correlation.engine_job_id,
+                    engine_request_id=continuation.engine_request_id,
+                    decision_id=None,
+                    signal_id=continuation.signal_id,
+                    enqueue_obligation_id=continuation.enqueue_obligation_id,
+                )
+            )
+            if continuation_receipt is None:
+                raise ProtocolConflict("admission_continuation_not_pending")
+            continuation_receipt_bytes = continuation_receipt
+            if (
+                correlation.continuation_receipt_bytes is not None
+                and correlation.continuation_receipt_bytes
+                != continuation_receipt_bytes
+            ):
+                raise ProtocolConflict("admission_continuation_receipt_conflict")
+            correlation.continuation_receipt_bytes = continuation_receipt_bytes
+            session.add(correlation)
+            await session.flush()
+            record = await self._trellis_correlation_in_session(
+                session, candidate.key
+            )
+            if record is None:
+                raise CorrelationUnknown(candidate.key)
+            return AdmissionCommit(
+                record=record,
+                continuation_receipt_bytes=continuation_receipt_bytes,
+            )
+
+    async def pending_trellis_admission_obligations(
+        self,
+    ) -> list[AdmissionEnqueueObligation]:
+        """Read each admission obligation that still requires dispatch proof."""
+        from langflow.services.trellis_v1.correlation import (
+            AdmissionEnqueueObligation,
+            TrellisJobCorrelation,
+        )
+
+        async with session_scope() as session:
+            statement = (
+                select(TrellisJobCorrelation)
+                .where(
+                    TrellisJobCorrelation.admission_receipt_bytes.is_not(None),
+                    TrellisJobCorrelation.continuation_engine_request_id.is_not(
+                        None
+                    ),
+                    TrellisJobCorrelation.continuation_signal_id.is_not(None),
+                    TrellisJobCorrelation.enqueue_obligation_id.is_not(None),
+                    TrellisJobCorrelation.continuation_receipt_bytes.is_not(None),
+                    TrellisJobCorrelation.enqueue_obligation_consumed_at.is_(None),
+                )
+                .order_by(
+                    TrellisJobCorrelation.created_at,
+                    TrellisJobCorrelation.actor_kind,
+                    TrellisJobCorrelation.actor_name,
+                    TrellisJobCorrelation.request_id,
+                )
+            )
+            rows = (await session.exec(statement)).all()
+            return [
+                AdmissionEnqueueObligation(
+                    engine_job_id=row.engine_job_id,
+                    engine_request_id=cast(
+                        str,
+                        row.continuation_engine_request_id,
+                    ),
+                    signal_id=cast(UUID, row.continuation_signal_id),
+                    enqueue_obligation_id=cast(UUID, row.enqueue_obligation_id),
+                    continuation_receipt_bytes=cast(
+                        bytes,
+                        row.continuation_receipt_bytes,
+                    ),
+                )
+                for row in rows
+            ]
+
+    async def mark_trellis_admission_obligation_consumed(
+        self,
+        *,
+        engine_job_id: UUID,
+        engine_request_id: str,
+        signal_id: UUID,
+        enqueue_obligation_id: UUID,
+        continuation_receipt_bytes: bytes,
+    ) -> None:
+        """Mark one exact admission obligation after durable dispatch proof."""
+        from langflow.services.trellis_v1.correlation import (
+            CorrelationUnknown,
+            ProtocolConflict,
+            TrellisJobCorrelation,
+        )
+
+        async with session_scope() as session:
+            statement = (
+                select(TrellisJobCorrelation)
+                .where(
+                    TrellisJobCorrelation.engine_job_id == engine_job_id,
+                    TrellisJobCorrelation.enqueue_obligation_id
+                    == enqueue_obligation_id,
+                )
+                .with_for_update()
+            )
+            correlation = (await session.exec(statement)).first()
+            if correlation is None:
+                raise CorrelationUnknown(enqueue_obligation_id)
+            if (
+                correlation.continuation_engine_request_id != engine_request_id
+                or correlation.continuation_signal_id != signal_id
+                or correlation.continuation_receipt_bytes
+                != continuation_receipt_bytes
+            ):
+                raise ProtocolConflict("admission_obligation_identity_conflict")
+            if correlation.enqueue_obligation_consumed_at is None:
+                correlation.enqueue_obligation_consumed_at = datetime.now(
+                    timezone.utc
+                )
+                session.add(correlation)
+                await session.flush()
+
+    @staticmethod
+    async def _trellis_correlation_in_session(
+        session: AsyncSession,
+        key: CorrelationKey,
+    ) -> StoredCorrelation | None:
+        from langflow.services.trellis_v1.correlation import (
+            StoredCorrelation,
+            TrellisJobCorrelation,
+        )
+
+        statement = select(TrellisJobCorrelation).where(
+            TrellisJobCorrelation.actor_kind == key.actor_kind,
+            TrellisJobCorrelation.actor_name == key.actor_name,
+            TrellisJobCorrelation.request_id == key.request_id,
+        )
+        correlation = (await session.exec(statement)).first()
+        if correlation is None:
+            return None
+        job = await session.get(Job, correlation.engine_job_id)
+        terminal_state = (
+            job.status.value
+            if job.status
+            in {
+                JobStatus.COMPLETED,
+                JobStatus.FAILED,
+                JobStatus.CANCELLED,
+                JobStatus.TIMED_OUT,
+            }
+            else None
+        )
+        return StoredCorrelation(
+            key=key,
+            host_id=correlation.host_id,
+            execution_id=correlation.execution_id,
+            job_id=correlation.engine_job_id,
+            engine_session_id=correlation.engine_session_id,
+            barrier_id=correlation.barrier_id,
+            submission_bytes=correlation.submission_bytes,
+            submission_bytes_digest=correlation.submission_bytes_digest,
+            correlation_receipt_bytes=correlation.correlation_receipt_bytes,
+            admission_receipt_bytes=correlation.admission_receipt_bytes,
+            terminal_state=terminal_state,
+        )
