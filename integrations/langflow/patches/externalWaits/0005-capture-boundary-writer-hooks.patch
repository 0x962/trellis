diff --git a/src/backend/base/langflow/services/trellis_v1/capture_writer.py b/src/backend/base/langflow/services/trellis_v1/capture_writer.py
new file mode 100644
index 0000000..9eb9af6
--- /dev/null
+++ b/src/backend/base/langflow/services/trellis_v1/capture_writer.py
@@ -0,0 +1,30 @@
+from __future__ import annotations
+
+from contextlib import asynccontextmanager
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncIterator
+
+    from langflow.services.trellis_v1.capture_boundary import CaptureBoundary
+
+_boundary: CaptureBoundary | None = None
+
+
+def install_capture_boundary(boundary: CaptureBoundary) -> None:
+    """Install the capture boundary before the engine admits work."""
+    global _boundary  # noqa: PLW0603
+    if _boundary is not None and _boundary is not boundary:
+        raise RuntimeError("capture_boundary_already_installed")
+    _boundary = boundary
+
+
+@asynccontextmanager
+async def engine_writer() -> AsyncIterator[None]:
+    """Hold writer admission for one database scope or graph pass."""
+    boundary = _boundary
+    if boundary is None:
+        yield
+        return
+    async with boundary.writer():
+        yield
