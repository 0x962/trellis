+    async def enqueue_trellis_submission(
+        self,
+        *,
+        engine_job_id: UUID,
+        flow_id: UUID,
+        user_id: UUID,
+        request_bytes: bytes,
+    ) -> Literal["dispatched", "execution_proven", "pending_lease", "cancelled"]:
+        """Dispatch an existing Trellis job through the Langflow queue."""
+        await self.start()
+        request = json.loads(request_bytes)
+        job_service = get_job_service()
+        request_digest = hashlib.sha256(request_bytes).hexdigest()
+        saved_request = await job_service.load_checkpoint(engine_job_id, "trellis-submission-request-v1")
+        if saved_request is None:
+            request_metadata = self._persisted_request_metadata(
+                job_id=engine_job_id,
+                flow_id=flow_id,
+                request=request,
+            )
+            job = await job_service.bind_trellis_submission_request(
+                engine_job_id=engine_job_id,
+                flow_id=flow_id,
+                user_id=user_id,
+                request_digest=request_digest,
+                request_metadata=request_metadata,
+            )
+        else:
+            if saved_request != request_digest:
+                raise RuntimeError("trellis_submission_request_conflict")
+            job = await job_service.get_job_by_job_id(engine_job_id)
+            if job is None:
+                raise RuntimeError("trellis_submission_job_missing")
+            if job.flow_id != flow_id or job.user_id != user_id:
+                raise RuntimeError("trellis_submission_job_conflict")
+        dispatch_kind = "trellis-submission-dispatch-v1"
+        dispatch_receipt = await job_service.load_checkpoint(engine_job_id, dispatch_kind)
+        if dispatch_receipt is not None:
+            if dispatch_receipt != request_digest:
+                raise RuntimeError("trellis_submission_dispatch_conflict")
+            return "dispatched"
+        if job.status == JobStatus.CANCELLED:
+            return "cancelled"
+        if job.status in {
+            JobStatus.IN_PROGRESS,
+            JobStatus.SUSPENDED,
+            JobStatus.COMPLETED,
+            JobStatus.FAILED,
+            JobStatus.TIMED_OUT,
+        }:
+            return "execution_proven"
+        if job.status != JobStatus.QUEUED:
+            raise RuntimeError("trellis_submission_dispatch_state_conflict")
+        if self._scaled:
+            await self._backend.enqueue(str(engine_job_id))
+            await job_service.save_checkpoint_once(engine_job_id, dispatch_kind, request_digest)
+            return "dispatched"
+        lease_heartbeat = datetime.now(timezone.utc).isoformat()
+        if not await job_service.claim_queued_lease(
+            engine_job_id,
+            owner=self._owner,
+            lease_ttl_s=self._settings.background_lease_ttl_s,
+            heartbeat_at=lease_heartbeat,
+        ):
+            refreshed = await job_service.get_job_by_job_id(engine_job_id)
+            if refreshed is None:
+                raise RuntimeError("trellis_submission_job_missing")
+            if refreshed.status == JobStatus.CANCELLED:
+                return "cancelled"
+            if refreshed.status != JobStatus.QUEUED:
+                return "execution_proven"
+
+            async def retry() -> None:
+                await self.enqueue_trellis_submission(
+                    engine_job_id=engine_job_id,
+                    flow_id=flow_id,
+                    user_id=user_id,
+                    request_bytes=request_bytes,
+                )
+
+            self._schedule_trellis_lease_retry(f"submission:{engine_job_id}", retry)
+            return "pending_lease"
+        try:
+            await self._enqueue(
+                job_id=engine_job_id,
+                flow_id=flow_id,
+                request=request,
+                user=self._user_stub(user_id),
+            )
+            await job_service.save_checkpoint_once(engine_job_id, dispatch_kind, request_digest)
+        except Exception:
+            await job_service.release_queued_lease(
+                engine_job_id,
+                owner=self._owner,
+                heartbeat_at=lease_heartbeat,
+            )
+            raise
+        return "dispatched"
