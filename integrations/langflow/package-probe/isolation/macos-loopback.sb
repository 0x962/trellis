(version 1)
(deny default)
(allow process*)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix*)
(allow file-read*)
(deny file-read* (subpath (param "DENIED_SSH")))
(deny file-read* (subpath (param "DENIED_GH")))
(deny file-read* (subpath (param "DENIED_AWS")))
(deny file-read* (subpath (param "DENIED_TRELLIS")))
(deny file-read* (literal (param "DENIED_CREDENTIAL")))
(allow file-write* (literal "/dev/null"))
(allow file-write* (subpath (param "RUN_ROOT")))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
