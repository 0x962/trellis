	"blockers": {
		"NATIVE_RESERVATION_UNAVAILABLE": "No executable component creates NativeRequestV1 and reserves its exact NativeHandleV1.",
		"NATIVE_RESULT_TRACE_REQUIRED": "The native completion component needs an actual suspension and resume trace with its saved result.",
		"HUMAN_REQUEST_UNAVAILABLE": "The engine occurrence producer must persist the exact HumanWaitV1 before a wait can execute.",
		"HUMAN_OUTCOME_UNMAPPED": "Approval output and rejection feedback need an executable successor mapping.",
		"JEV_INVOCATION_UNAVAILABLE": "No executable component invokes and binds the durable Jev classification service.",
		"GROUP_SCOPE_UNMAPPED": "Scope entries, boundary dependencies, skipped children, and nested output references need executable expansion.",
		"GROUP_DEADLINE_UNMAPPED": "Original first-launch deadlines need the native clock service at the scope boundary.",
		"LOOP_SEMANTICS_UNPROVEN": "The nested stock-loop trace fails; child-then-condition behavior has no accepted mapping.",
		"LEGACY_CONFIGURATION_UNMAPPED": "Retained fields have no complete executable configuration mapping.",
