diff --git a/src/customization/trellis-editor-canvas.ts b/src/customization/trellis-editor-canvas.ts
new file mode 100644
--- /dev/null
+++ b/src/customization/trellis-editor-canvas.ts
@@ -0,0 +1,36 @@
+type CanvasNode = {
+  id: string;
+  initialWidth?: number;
+  initialHeight?: number;
+  handles?: unknown[];
+  measured?: { width?: number; height?: number };
+};
+
+export function trellisCanvasNodes<T extends CanvasNode>(nodes: T[]): T[] {
+  return nodes.map((node) => ({
+    ...node,
+    initialWidth: node.initialWidth ?? 320,
+    initialHeight: node.initialHeight ?? 800,
+    // ReactFlow mounts every node without handle metadata, even outside the
+    // viewport. Visible nodes replace these empty handles after measurement.
+    ...(!node.measured?.width || !node.measured?.height
+      ? { handles: node.handles ?? [] }
+      : {}),
+  }));
+}
+
+export function trellisCanvasEdges<
+  T extends CanvasNode,
+  E extends { source: string; target: string },
+>(nodes: T[], edges: E[]): E[] {
+  const measured = new Set(
+    nodes
+      .filter((node) => node.measured?.width && node.measured?.height)
+      .map((node) => node.id),
+  );
+  // ReactFlow needs measured ports at both ends to draw an edge. The save
+  // hook reads all edges from the flow store, not this canvas projection.
+  return edges.filter(
+    (edge) => measured.has(edge.source) && measured.has(edge.target),
+  );
+}
