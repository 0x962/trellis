diff --git a/src/customization/trellis-editor-save.ts b/src/customization/trellis-editor-save.ts
new file mode 100644
--- /dev/null
+++ b/src/customization/trellis-editor-save.ts
@@ -0,0 +1,148 @@
+import type { ReactFlowJsonObject } from "@xyflow/react";
+import { isAxiosError } from "axios";
+import { api } from "@/controllers/API/api";
+import useFlowsManagerStore from "@/stores/flowsManagerStore";
+
+type PendingTrellisSave = {
+  autoSavingWasEnabled: boolean;
+  body: string;
+  expectedVersion: number;
+  graphDocument: ReactFlowJsonObject;
+  requestId: string;
+};
+
+export type TrellisSaveState = "conflict" | "failed" | "idle";
+
+type TrellisSavedDocument = {
+  revision: number;
+  flow: Record<string, unknown>;
+  graphDocument: ReactFlowJsonObject;
+};
+
+const acceptedRevisions = new Map<string, number>();
+const pendingSaves = new Map<string, PendingTrellisSave>();
+const failedFlows = new Set<string>();
+const conflictedFlows = new Set<string>();
+const saveStateListeners = new Set<() => void>();
+
+const emitSaveState = () => {
+  for (const listener of saveStateListeners) listener();
+};
+
+export const subscribeToTrellisSaveState = (listener: () => void) => {
+  saveStateListeners.add(listener);
+  return () => {
+    saveStateListeners.delete(listener);
+  };
+};
+
+export const trellisSaveState = (
+  flowId: string | undefined,
+): TrellisSaveState => {
+  if (flowId === undefined) return "idle";
+  if (conflictedFlows.has(flowId)) return "conflict";
+  if (failedFlows.has(flowId)) return "failed";
+  return "idle";
+};
+
+const saveFor = (
+  flowId: string,
+  graphDocument: ReactFlowJsonObject,
+): PendingTrellisSave => {
+  const pending = pendingSaves.get(flowId);
+  if (conflictedFlows.has(flowId)) {
+    throw new Error("Reload the document after a version conflict.");
+  }
+  if (failedFlows.has(flowId)) {
+    throw new Error("Use Retry save for the failed write.");
+  }
+
+  const body = JSON.stringify(graphDocument);
+  if (pending?.body === body) return pending;
+
+  const save = {
+    autoSavingWasEnabled: useFlowsManagerStore.getState().autoSaving,
+    body,
+    expectedVersion:
+      acceptedRevisions.get(flowId) ??
+      Number(import.meta.env.VITE_TRELLIS_EDITOR_REVISION),
+    graphDocument,
+    requestId: crypto.randomUUID(),
+  };
+  pendingSaves.set(flowId, save);
+  return save;
+};
+
+const submitSave = async (
+  flowId: string,
+  save: PendingTrellisSave,
+): Promise<TrellisSavedDocument> => {
+  const response = await api.put("/api/trellis-editor/v1/document", {
+    flow: flowId,
+    expectedVersion: save.expectedVersion,
+    requestId: save.requestId,
+    schemaVersion: 1,
+    engine: "langflow",
+    graphDocument: save.graphDocument,
+    componentManifestHash: import.meta.env.VITE_TRELLIS_COMPONENT_MANIFEST_HASH,
+  });
+  return response.data as TrellisSavedDocument;
+};
+
+const submitPendingSave = async (
+  flowId: string,
+  save: PendingTrellisSave,
+): Promise<TrellisSavedDocument> => {
+  try {
+    const document = await submitSave(flowId, save);
+    if (pendingSaves.get(flowId) === save) {
+      acceptedRevisions.set(flowId, document.revision);
+      pendingSaves.delete(flowId);
+    }
+    failedFlows.delete(flowId);
+    useFlowsManagerStore.getState().setAutoSaving(save.autoSavingWasEnabled);
+    emitSaveState();
+    return document;
+  } catch (error) {
+    if (isAxiosError(error) && error.response === undefined) {
+      failedFlows.add(flowId);
+      useFlowsManagerStore.getState().setAutoSaving(false);
+      emitSaveState();
+      throw error;
+    }
+
+    if (isAxiosError(error) && error.response?.status === 409) {
+      conflictedFlows.add(flowId);
+      failedFlows.delete(flowId);
+      useFlowsManagerStore.getState().setAutoSaving(false);
+      emitSaveState();
+      throw error;
+    }
+
+    if (pendingSaves.get(flowId) === save) {
+      pendingSaves.delete(flowId);
+    }
+    throw error;
+  }
+};
+
+export const retryTrellisEditorDocument = async (
+  flowId: string,
+): Promise<void> => {
+  const save = pendingSaves.get(flowId)!;
+  useFlowsManagerStore.getState().setSaveLoading(true);
+  try {
+    await submitPendingSave(flowId, save);
+  } finally {
+    useFlowsManagerStore.getState().setSaveLoading(false);
+  }
+};
+
+export const saveTrellisEditorDocument = async (input: {
+  flowId: string;
+  graphDocument: ReactFlowJsonObject;
+}): Promise<Record<string, unknown>> => {
+  const save = saveFor(input.flowId, input.graphDocument);
+  const document = await submitPendingSave(input.flowId, save);
+  return { ...document.flow, data: document.graphDocument };
+};
