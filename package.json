{
	"name": "trellis",
	"private": true,
	"description": "A local ticket tracker for work that humans give to coding agents.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/0x962/trellis#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0x962/trellis.git"
	},
	"bugs": {
		"url": "https://github.com/0x962/trellis/issues"
	},
	"keywords": [
		"tickets",
		"issue-tracker",
		"agents",
		"local-first",
		"bun",
		"pglite",
		"cli"
	],
	"engines": {
		"bun": ">=1.3.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "turbo run dev --filter=@trellis/server --filter=@trellis/web",
		"dev:all": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"test:int": "turbo run test:int",
		"test:repo": "bun test ./test --path-ignore-patterns '**/test/int/**'",
		"test:repo:int": "bun test ./test/int",
		"typecheck": "turbo run typecheck",
		"typecheck:repo": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "bun scripts/check.ts",
		"perf": "turbo run perf",
		"perf:10k": "turbo run perf:10k --concurrency=1",
		"db:generate": "turbo run db:generate --filter=@trellis/server",
		"e2e": "bun run --cwd apps/web e2e",
		"release": "changeset version && bun install && changeset tag",
		"test:host": "bun run --cwd apps/runtime test:int && bun run --cwd apps/server test:host",
		"test:host:real": "TRELLIS_REAL_HARNESS_ACCEPTANCE=1 bun run --cwd apps/server test:host"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "3.0.2",
		"@types/bun": "1.3.13",
		"turbo": "2.10.12",
		"typescript": "7.0.2"
	},
	"trustedDependencies": [
		"fs-ext"
	]
}
