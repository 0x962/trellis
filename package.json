{
	"name": "trellis",
	"private": true,
	"description": "A local ticket tracker for work that humans give to coding agents.",
	"license": "Apache-2.0",
	"homepage": "https://github.com/0x962/trellis#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0x962/trellis.git"
	},
	"bugs": {
		"url": "https://github.com/0x962/trellis/issues"
	},
	"keywords": [
		"tickets",
		"issue-tracker",
		"agents",
		"local-first",
		"bun",
		"pglite",
		"cli"
	],
	"engines": {
		"bun": ">=1.3.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "turbo run dev --filter=@trellis/server --filter=@trellis/web",
		"dev:all": "turbo run dev",
		"desktop:install": "bun apps/desktop/scripts/install-production.ts",
		"desktop:preview": "node apps/web/scripts/desktopPreview/run.ts",
		"storybook": "bun run --cwd apps/web storybook",
		"storybook:build": "bun run --cwd apps/web storybook:build",
		"storybook:serve": "bun run --cwd apps/web storybook:serve",
		"storybook:check": "bun run --cwd apps/web storybook:check",
		"storybook:typecheck": "bun run --cwd apps/web storybook:typecheck",
		"storybook:test": "bun run --cwd apps/web storybook:test",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"typecheck:repo": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "bun scripts/check.ts",
		"db:generate": "turbo run db:generate --filter=@trellis/server",
		"release": "changeset version && bun install && changeset tag"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "3.0.2",
		"@types/bun": "1.3.13",
		"turbo": "2.10.12",
		"typescript": "7.0.2"
	},
	"trustedDependencies": [
		"fs-ext"
	],
	"patchedDependencies": {
		"@xterm/addon-webgl@0.20.0-beta.297": "patches/@xterm%2Faddon-webgl@0.20.0-beta.297.patch"
	},
	"overrides": {
		"@tiptap/extension-highlight": "3.31.3"
	}
}
