{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["TRELLIS_*"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {},
		"lint": {},
		"db:generate": {
			"cache": false,
			"outputs": ["drizzle/**"]
		},
		"//#lint": {},
		"//#typecheck:repo": {}
	}
}
