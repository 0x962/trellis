{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["TRELLIS_*"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {},
		"test:int": {},
		"typecheck": {},
		"lint": {},
		"db:generate": {
			"cache": false,
			"outputs": ["drizzle/**"]
		},
		"perf": {
			"cache": false
		},
		"perf:10k": {
			"cache": false
		},
		"size-budget": {
			"dependsOn": ["build"]
		},
		"//#lint": {},
		"//#typecheck:repo": {},
		"//#test:repo": {
			"cache": false
		},
		"//#test:repo:int": {
			"cache": false
		}
	}
}
